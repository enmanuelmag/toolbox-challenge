{
  "name": "toolbox-challenge",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "**/node-releases": "2.0.19"
  },
  "scripts": {
    "start": "yarn workspace @toolbox/api start",
    "start:api": "yarn workspace @toolbox/api start",
    "start:web": "yarn workspace @toolbox/web start",
    "test": "yarn test:unit && yarn test:integration",
    "test:unit": "yarn workspaces run test",
    "test:integration": "mocha tests/integration/**/*.test.js",
    "build": "yarn workspace @toolbox/web build",
    "verify": "yarn test && yarn build"
  },
  "devDependencies": {
    "mocha": "10.8.2",
    "standard": "17.1.2"
  }
}